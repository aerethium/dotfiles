{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 0,
  "height": 26,

  "margin-top": 8,
  "margin-left": 8,
  "margin-right": 8,

  "modules-left": ["custom/arch", "hyprland/workspaces", "mpris", "custom/cava", "group/tray-expander"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "custom/weather",
    "pulseaudio",
    "pulseaudio#microphone",
    "bluetooth",
    "network",
    "battery",
    "power-profiles-daemon",
    "clock",
    "custom/notification"
  ],

  "hyprland/workspaces": {
    "on-click": "activate",
    "format": "{name}",
    "sort-by": "id",
    "persistent-workspaces": {
      "1": [],
      "2": [],
      "3": [],
      "4": [],
      "5": []
    }
  },

  "custom/arch": {
    "format": "󰣇",
    "on-click": "vicinae toggle",
    "on-click-right": "wlogout -b 6 -c 0 -r 0 -m 50 -T 480 -B 480",
    "tooltip-format": "App Launcher\n\nRight click: Power Menu"
  },

  "custom/cava": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cava.sh",
    "restart-interval": 5,
    "tooltip": false
  },

  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "tooltip-format": "Microphone: {source_volume}%",
    "scroll-step": 5
  },

  "clock": {
    "format": "󰸗 {:%a %b %d - %I:%M:%S %p}",
    "format-alt": "{:%A %m/%d/%Y}",
    "interval": 1,
    "tooltip-format": "<span>{calendar}</span>",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b>{}</b></span>"
      }
    }
  },

  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "on-click": "kitty --title nmtui -e nmtui"
  },

  "battery": {
    "format": "{capacity}% {icon}",
    "format-discharging": "{capacity}% {icon} {time}",
    "format-charging": "{capacity}% {icon} {time}",
    "format-plugged": "{capacity}% ",
    "format-not-charging": "{capacity}% {icon}",
    "format-icons": {
      "charging": ["󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"],
      "default": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"]
    },
    "format-full": "100% 󰂅",
    "tooltip-format-discharging": "{power:>1.0f}W↓ {capacity}%",
    "tooltip-format-charging": "{power:>1.0f}W↑ {capacity}%",
    "interval": 5,
    "states": {
      "good": 70,
      "medium": 30,
      "warning": 15,
      "critical": 10
    }
  },

  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "󰂲",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "kitty --title bluetui -e bluetui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "󰝟 muted",
    "format-icons": {
      "headphone": "󰋋",
      "headset": "󰋎",
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "custom/expand-icon": {
    "format": "󰅂",
    "tooltip": false
  },

  "tray": {
    "icon-size": 12,
    "spacing": 12
  },

  "custom/weather": {
    "format": "{}°",
    "tooltip": true,
    "interval": 600,
    "exec": "wttrbar --location Mdiq --ampm",
    "return-type": "json"
  },

  "mpris": {
    "format": " {artist} - {title}",
    "format-paused": " <s>{artist} - {title}</s>",
    "player-icons": {
      "default": "",
      "mpv": ""
    },
    "status-icons": {
      "paused": ""
    },
    "on-click": "playerctl play-pause",
    "max-length": 30,
    "dynamic-order": ["title", "artist"]
  },

  "hyprland/window": {
    "format": "{initialTitle}",
    "separate-outputs": true,
    "rewrite": {
      "^$": "",
      "(.*) - Chromium - chromium": "  $1",
      "(.*) - Discord - discord": "   $1",
      "(.*) - Obsidian - .* - obsidian": "  $1",
      "(.*) - com.mitchellh.ghostty": "  $1",
      "(.*) - Alacritty": "  $1",
      "(.*) - BeeperTexts": "󰻞  $1",
      "(.*) - org.gnome.Nautilus": "  $1"
    }
  },

  "power-profiles-daemon": {
    "format": "{icon} {profile}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "󰾅",
      "performance": "󰓅",
      "balanced": "󰾅",
      "power-saver": "󰾆"
    }
  },

  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󰂚",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "escape": true
  }
}
